diff --git a/tools/server/tests/unit/test_rerank.py b/tools/server/tests/unit/test_rerank.py
index 53f15af..037f2cc 100644
--- a/tools/server/tests/unit/test_rerank.py
+++ b/tools/server/tests/unit/test_rerank.py
@@ -1,3 +1,5 @@
+import math
+import os
 import pytest
 from utils import *
 
@@ -169,3 +171,122 @@ def test_rerank_tei_top_n(top_n, expected_len):
     res = server.make_request("POST", "/rerank", data=data)
     assert res.status_code == 200
     assert len(res.body) == expected_len
+
+
+CAUSAL_DOCUMENTS = TEST_DOCUMENTS + [
+    "Gradient descent minimizes a function by taking repeated steps against its gradient.",
+    "The Eiffel Tower is a wrought-iron lattice tower on the Champ de Mars in Paris.",
+    "A neural network is a model of connected units whose weights are learned from data.",
+    "Bread is a staple food made from a dough of flour and water, usually by baking.",
+]
+
+
+def qwen3_reranker() -> ServerProcess:
+    # a causal reranker: all prompts of a rerank request start with the same template text and query
+    server = ServerProcess()
+    local_model = os.environ.get("QWEN3_RERANKER_LOCAL_MODEL")
+    if local_model:
+        server.model_file = local_model
+        server.model_hf_repo = None
+        server.model_hf_file = None
+    else:
+        server.model_hf_repo = "ggml-org/Qwen3-Reranker-0.6B-Q8_0-GGUF"
+        server.model_hf_file = "qwen3-reranker-0.6b-q8_0.gguf"
+    server.server_reranking = True
+    server.server_metrics = True
+    server.n_ctx = 4096
+    server.n_batch = 1024
+    server.n_ubatch = 64
+    server.n_slots = 8
+    server.kv_unified = True
+    return server
+
+
+def rerank(server: ServerProcess, query: str, documents: list) -> tuple[list[float], int]:
+    res = server.make_request("POST", "/rerank", data={"query": query, "documents": documents})
+    assert res.status_code == 200
+    results = sorted(res.body["results"], key=lambda r: r["index"])
+    assert [r["index"] for r in results] == list(range(len(documents)))
+    return [r["relevance_score"] for r in results], res.body["usage"]["prompt_tokens"]
+
+
+def prompt_tokens_processed(server: ServerProcess) -> float:
+    res = server.make_request("GET", "/metrics")
+    assert res.status_code == 200
+    for line in res.body.splitlines():
+        if line.startswith("llamacpp:prompt_tokens_total "):
+            return float(line.split()[1])
+    raise AssertionError("/metrics has no llamacpp:prompt_tokens_total")
+
+
+def assert_close_scores(scores: list[float], expected: list[float]):
+    # batching changes the rounding also without prefix sharing, here by up to 0.25 in logit space; a wrong prefix changes more
+    logit = lambda p: math.log(p / (1 - p))
+    assert all(abs(logit(a) - logit(b)) < 0.5 for a, b in zip(scores, expected)), (scores, expected)
+
+
+@pytest.mark.heavy
+@pytest.mark.slow
+@pytest.mark.parametrize("n_slots,kv_unified,documents,shared", [
+    (8, True, CAUSAL_DOCUMENTS, True),
+    (3, True, CAUSAL_DOCUMENTS, True),          # more documents than slots
+    (4, True, [TEST_DOCUMENTS[2]] * 4, True),   # equal prompts: each task keeps only its last token
+    (8, False, CAUSAL_DOCUMENTS, False),        # one KV stream per slot: nothing is shared
+])
+def test_rerank_shared_prefix(n_slots, kv_unified, documents, shared):
+    server = qwen3_reranker()
+    server.n_slots = n_slots
+    server.kv_unified = kv_unified
+    server.start()
+    separate = [rerank(server, "Machine learning is", [doc]) for doc in documents]
+    n_before = prompt_tokens_processed(server)
+    scores, n_prompt = rerank(server, "Machine learning is", documents)
+    # the usage counts every prompt in full, but the shared prefix is evaluated once per group of documents
+    assert n_prompt == sum(n for _, n in separate)
+    assert (prompt_tokens_processed(server) - n_before < n_prompt) == shared
+    assert_close_scores(scores, [s[0] for s, _ in separate])
+
+
+@pytest.mark.heavy
+@pytest.mark.slow
+def test_rerank_shared_prefix_needs_one_ubatch():
+    # the shared prefix costs a decode step of its own, so it is shared only if this skips at least one ubatch
+    server = qwen3_reranker()
+    server.n_ubatch = 1024
+    server.start()
+    _, n_prompt = rerank(server, "Machine learning is", CAUSAL_DOCUMENTS[:2])
+    assert prompt_tokens_processed(server) == n_prompt
+
+
+@pytest.mark.heavy
+@pytest.mark.slow
+def test_rerank_shared_prefix_concurrent():
+    server = qwen3_reranker()
+    server.start()
+    queries = ["Machine learning is", "Which city?", "How is bread made?", "What does a neural network learn?"]
+    sequential = [rerank(server, query, CAUSAL_DOCUMENTS)[0] for query in queries]
+    concurrent = parallel_function_calls([(rerank, (server, query, CAUSAL_DOCUMENTS)) for query in queries])
+    for scores, (expected, _) in zip(sequential, concurrent):
+        assert_close_scores(scores, expected)
+
+
+@pytest.mark.heavy
+@pytest.mark.slow
+@pytest.mark.parametrize("kv_unified", [False, True])
+def test_rerank_shared_prefix_skips_prompt_cache(kv_unified, tmp_path):
+    server = qwen3_reranker()
+    server.n_slots = 2
+    server.n_ubatch = 32
+    server.cache_ram = 100
+    server.kv_unified = kv_unified
+    server.debug = True
+    server.log_path = str(tmp_path / "server.log")
+    server.start()
+    for i in range(4):
+        rerank(server, f"query {i}", CAUSAL_DOCUMENTS[i:i + 4])
+    server.stop()
+
+    with open(server.log_path) as f:
+        log = f.read()
+    assert "__TEST_TAG_CACHE_IDLE_SLOTS_ENABLED__" in log
+    assert "__TEST_TAG_CACHE_IDLE_SLOT__" not in log
