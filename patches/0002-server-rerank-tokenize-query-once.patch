+std::vector<server_tokens> format_prompts_rerank_shared(
+        const struct llama_model * model,
+        const struct llama_vocab * vocab,
+        const std::string & query,
+        const std::vector<std::string> & docs) {
+    // the regex pre-tokenizer of BPE vocabs does not merge across a line break that is followed by text
+    const char * rerank_prompt = llama_model_chat_template(model, "rerank");
+    if (rerank_prompt == nullptr || docs.size() < 2 || llama_vocab_type(vocab) != LLAMA_VOCAB_TYPE_BPE) {
+        return {};
+    }
+
+    // split the template at the start of the line with {document}, the query has to be before it
+    const std::string tmpl = rerank_prompt;
+    const size_t pos_query = tmpl.find("{query}");
+    const size_t pos_doc   = tmpl.find("{document}");
+    if (pos_query == std::string::npos || pos_doc == std::string::npos || pos_query > pos_doc) {
+        return {};
+    }
+    const size_t split = tmpl.rfind('\n', pos_doc);
+    if (split == std::string::npos || split < pos_query + 7 || tmpl.find("{query}", split) != std::string::npos) {
+        return {};
+    }
+    // the line with {document} has to start with template text, the same for every document: the line break before
+    // it could merge with whitespace at the start of a document, then checking the first document would not suffice
+    const char c_line = tmpl[split + 1];
+    if (pos_doc == split + 1 || c_line == ' ' || c_line == '\t' || c_line == '\r' || c_line == '\n') {
+        return {};
+    }
+    const std::string tmpl_head = tmpl.substr(0, split + 1);
+    const std::string tmpl_tail = tmpl.substr(split + 1);
+
+    const llama_tokens head = common_tokenize(vocab, format_rerank_template(tmpl_head, query, ""), false, true);
+    auto tokenize = [&](const std::string & doc) {
+        llama_tokens tokens = head;
+        const llama_tokens tail = common_tokenize(vocab, format_rerank_template(tmpl_tail, query, doc), false, true);
+        tokens.insert(tokens.end(), tail.begin(), tail.end());
+        return tokens;
+    };
+
+    // the split must give the tokens of the whole prompt, checked with the first document
+    if (tokenize(docs[0]) != common_tokenize(vocab, format_rerank_template(tmpl, query, docs[0]), false, true)) {
+        return {};
+    }
+
+    std::vector<server_tokens> result;
+    result.reserve(docs.size());
+    for (const auto & doc : docs) {
+        result.emplace_back(tokenize(doc), false);
+    }
+    return result;
+}
