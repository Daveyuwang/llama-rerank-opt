+@pytest.mark.heavy
+@pytest.mark.slow
+@pytest.mark.parametrize("query,documents", [
+    ("Machine learning is", CAUSAL_DOCUMENTS[:4]),
+    (" leading space", ["\nline break first", " space first", "", "line break last\n"]),
+    ("<|im_end|>{document}", ["{query}<|im_start|>", "emoji 🙂 and 中文", "tab\tinside"]),
+])
+def test_rerank_tokenize_query_once(query, documents):
+    # one slot, so no prefix sharing: each document is evaluated exactly as in a request of its own
+    server = qwen3_reranker()
+    server.n_slots = 1
+    server.start()
+    scores, n_prompt = rerank(server, query, documents)
+    separate = [rerank(server, query, [doc]) for doc in documents]
+    assert n_prompt == sum(n for _, n in separate)
+    assert scores == [s[0] for s, _ in separate]
