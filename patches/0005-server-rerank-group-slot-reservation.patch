+void server_queue::pop_deferred_task_id(int id_task) {
+    std::unique_lock<std::mutex> lock(mutex_tasks);
+    for (auto it = queue_tasks_deferred.begin(); it != queue_tasks_deferred.end(); ++it) {
+        if (it->id == id_task) {
+            QUE_DBG("pop deferred task, id_task = %d\n", id_task);
+            queue_tasks.emplace_front(std::move(*it));
+            queue_tasks_deferred.erase(it);
+            break;
+        }
+    }
+    time_last_task = ggml_time_ms();
+    condition_tasks.notify_one();
+}
+
+void server_queue::remove_deferred(int id_task) {
+    std::unique_lock<std::mutex> lock(mutex_tasks);
+    queue_tasks_deferred.erase(
+        std::remove_if(queue_tasks_deferred.begin(), queue_tasks_deferred.end(),
+            [id_task](const server_task & task) { return task.id == id_task; }),
+        queue_tasks_deferred.end());
+}
+
+int server_queue::promote_deferred(const std::function<bool(const server_task &)> & pred, size_t & n_tasks) {
+    std::unique_lock<std::mutex> lock(mutex_tasks);
+    for (auto it = queue_tasks_deferred.begin(); it != queue_tasks_deferred.end(); ++it) {
+        if (pred(*it)) {
+            const int id_task = it->id;
+            n_tasks = it->child_tasks.size() + 1;
+            server_task task = std::move(*it);
+            queue_tasks_deferred.erase(it);
+            queue_tasks_deferred.push_front(std::move(task));
+            return id_task;
+        }
+    }
+    n_tasks = 0;
+    return -1;
+}
