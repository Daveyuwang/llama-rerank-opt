+// causal mask of n_seq sequences of unequal length that share one K/V slice, like a multi-sequence ubatch:
+// a query sees the earlier tokens of its own sequence and the first n_prefix positions (a prefix shared by all sequences),
+// the queries are the last ne1 K/V positions
+// n_lead K/V positions at the start that no query sees (e.g. an earlier request), then n_prefix positions that every
+// query sees, then the n_seq sequences; the queries are the last tensor->ne[1] positions
+static void init_tensor_kq_mask_seq_diag(ggml_tensor * tensor, int64_t n_seq, int64_t n_prefix, int64_t n_lead = 0) {
+    GGML_ASSERT(tensor->type == GGML_TYPE_F16);
+
+    const int64_t n_kv = tensor->ne[0];
+    const int64_t n_q  = tensor->ne[1];
+    GGML_ASSERT(n_seq > 0 && n_kv - n_q >= n_lead && n_kv >= n_lead + n_prefix + 3*n_seq);
+
+    // sequence s gets a share of the K/V positions after the prefix proportional to s % 3 + 1
+    std::vector<int64_t> start(n_seq + 1, n_lead + n_prefix);
+    int64_t n_weight = 0;
+    for (int64_t s = 0; s < n_seq; ++s) {
+        n_weight += s % 3 + 1;
+    }
+    int64_t acc = 0;
+    for (int64_t s = 0; s < n_seq; ++s) {
+        acc += s % 3 + 1;
+        start[s + 1] = n_lead + n_prefix + (n_kv - n_lead - n_prefix)*acc/n_weight;
+    }
+
+    std::vector<ggml_fp16_t> data(ggml_nelements(tensor));
+    for (int64_t i23 = 0; i23 < tensor->ne[2]*tensor->ne[3]; ++i23) {
+        for (int64_t iq = 0; iq < n_q; ++iq) {
+            const int64_t pos = n_kv - n_q + iq;
+            int64_t s = 0;
+            while (start[s + 1] <= pos) {
+                ++s;
+            }
+            for (int64_t ik = 0; ik < n_kv; ++ik) {
+                const bool visible = ik <= pos && ((ik >= n_lead && ik < n_lead + n_prefix) || ik >= start[s]);
+                data[(i23*n_q + iq)*n_kv + ik] = ggml_fp32_to_fp16(visible ? 0.0f : -INFINITY);
+            }
+        }
+    }
+    ggml_backend_tensor_set(tensor, data.data(), 0, data.size()*sizeof(ggml_fp16_t));
+}
